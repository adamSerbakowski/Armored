{% extends 'base.html.twig' %}

{% block title %}Armored vehicle database{% endblock %}

{% block body %}
<style>
    body { margin: 0; background: #171a17; color: #eef0e8; font: 18px/1.6 sans-serif; }
    main { margin: 0 auto; max-width: 800px; padding: 8rem 2rem; }
    p { max-width: 680px; color: #c8cdbf; }
    .eyebrow { color: #a9b88c; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
    h1 { margin: 0.25rem 0 1rem; font-family: Georgia, serif; font-size: clamp(3rem, 10vw, 6rem); line-height: 1; }
</style>

<main>
    <div class="eyebrow">Historical and modern vehicles</div>
    <h1>Armored</h1>
    <p>
        An interactive, sourced database of armored vehicles, their variants,
        operators, origins, service histories, production, and technical data.
    </p>
</main>
{% endblock %}
